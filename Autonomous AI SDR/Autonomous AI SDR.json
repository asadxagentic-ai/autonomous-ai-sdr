    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst aiContent = $json.output || '{}';\nlet parsed = {};\ntry { parsed = JSON.parse(aiContent); } catch(e) {\n  const m = aiContent.match(/```json\\n?([\\s\\S]*?)```/);\n  if (m) try { parsed = JSON.parse(m[1]); } catch(e2) {}\n  if (!parsed.email_body) {\n    const jm = aiContent.match(/\\{[\\s\\S]*\\}/);\n    if (jm) try { parsed = JSON.parse(jm[0]); } catch(e3) {}\n  }\n}\nconst contact = $('Filter Contacts for Outreach').item.json;\nreturn { json: {\n  contactId: contact.id || contact.vid,\n  email: contact.properties?.email,\n  firstName: contact.properties?.firstname,\n  company: contact.properties?.company,\n  action: contact.action,\n  seqDay: contact.seqDay,\n  icp_score: parsed.icp_score || 5,\n  personalization: parsed.personalization || '',\n  subject: parsed.subject || 'Quick question about ' + (contact.properties?.company || 'your company'),\n  email_body: parsed.email_body || '',\n  companyNews: parsed.company_news || '',\n}};\n      "
      },
