    {
      "parameters": {
        "jsCode": "\nconst today = new Date();\nconst filtered = [];\nfor (const item of $input.all()) {\n  const props = item.json.properties || {};\n  const email = props.email;\n  if (!email) continue;\n  const status = (props.outreach_status || 'Not Started').trim();\n  const icpScore = parseFloat(props.icp_score || '0');\n  if (icpScore > 0 && icpScore < 5) continue;\n  if (['Booked','Closed','Low ICP'].includes(status)) continue;\n  const lastEmailDate = props.last_email_sent_date ? new Date(props.last_email_sent_date) : null;\n  const seqDay = parseInt(props.sequence_day || '0');\n  const daysSinceLast = lastEmailDate ? Math.floor((today - lastEmailDate) / (1000*60*60*24)) : 999;\n  if (!status || status === 'Not Started') {\n    filtered.push({ ...item.json, action: 'send_intro', seqDay: 1 });\n  } else if (status === 'Emailed' && daysSinceLast >= 3 && seqDay === 1) {\n    filtered.push({ ...item.json, action: 'send_followup', seqDay: 3 });\n  } else if (status === 'Followed Up' && daysSinceLast >= 4 && seqDay === 3) {\n    filtered.push({ ...item.json, action: 'send_breakup', seqDay: 7 });\n  }\n}\nreturn filtered.map(f => ({ json: f }));\n      "
      },
