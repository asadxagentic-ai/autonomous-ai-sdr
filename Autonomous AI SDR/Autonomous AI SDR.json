      "parameters": {
        "jsCode": "\nconst response = $input.first().json;\nconst people = response.people || response.contacts || [];\nif (!people.length) return [{ json: { error: 'No leads returned from Apollo' } }];\nconst leads = [];\nfor (const person of people) {\n  const email = person.email || person.contact?.email;\n  if (!email || email.includes('*')) continue;\n  leads.push({ json: {\n    firstname: person.first_name || '',\n    lastname: person.last_name || '',\n    email: email,\n    jobtitle: person.title || '',\n    company: person.organization?.name || '',\n    linkedin_url: person.linkedin_url || '',\n    industry: person.organization?.industry || '',\n    company_website: person.organization?.website_url || '',\n  }});\n}\nreturn leads.length > 0 ? leads : [{ json: { error: 'No verified emails found' } }];\n      "
      },
